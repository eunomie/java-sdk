"""
Java SDK provider for the module-max UX (dagger/dagger#13992).

The engine detects this SDK by the complete set of `clientScope`,
`generateModule` and `generateClient` functions. The engine owns the workspace
config, target resolution, the local generation graph and order, and the atomic
workspace changeset; each SDK call receives a Workspace whose cwd is the
persisted scope and returns the modified Workspace. This module only detects the
scope and writes files inside it.

Modules use the self-contained layout: the Java SDK is vendored as source and
code is generated into the module (see `generateModule`), and the runtime is
this repository's build/package-only runtime
(`github.com/dagger/java-sdk/runtime`). Because the generated files are
committed, the runtime skips codegen at module load and just builds and packages
the committed sources.
"""
type JavaSdk {
  """
  Runtime source written into the dagger-module.toml of new Java modules.
  """
  runtimeSource: String! = "github.com/dagger/java-sdk/runtime"

  """
  Template a new module is initialized from: default*, empty, legacy.
  Surfaced by the engine as `--java-template`.
  """
  template: String! = "default"

  """
  Commit the compiled Dagger Java SDK as a jar into each generated module so its
  runtime build compiles only the module's own code against the jar instead of
  recompiling the vendored SDK sources. The sources stay checked in for IDE use.
  Opt-in because it adds a committed binary artifact. Surfaced by the engine as
  `--java-vendor-sdk-jar`.
  """
  vendorSdkJar: Boolean! = false

  """
  Detect the Java client-generation scope for Workspace.cwd: the nearest Maven
  project (a directory holding pom.xml) at or above cwd. Returns "." for the
  workspace root and "" when there is no enclosing Maven project.
  """
  clientScope(ws: Workspace!): String! {
    let pom = ws.findUp("pom.xml")
    if (pom == null) {
      ""
    } else {
      configDir(pom, "pom.xml")
    }
  }

  """
  Initialize or regenerate the Java module in Workspace.cwd.

  The engine sets Workspace.cwd to the persisted scope, does not create
  dagger-module.toml, and diffs the returned workspace. The presence of
  dagger-module.toml selects behaviour: absent, scaffold the template and write
  the config; present, regenerate over the committed state. The result always
  carries a valid dagger-module.toml in the scope.
  """
  generateModule(ws: Workspace!): Workspace! {
    let rootPath = normalizePath(ws.cwd)
    let name = basename(rootPath)
    let scaffolded = if (exists(ws, joinPath(rootPath, "dagger-module.toml"))) {
      ws
    } else {
      ws
        .withNewDirectory(workspaceRef(rootPath), renderedTemplate(name, selectedTemplate))
        .withNewFile(workspaceRef(joinPath(rootPath, "dagger-module.toml")), moduleConfig(name))
    }
    Mod(rootPath: rootPath, ws: scaffolded, vendorSdkJar: vendorSdkJar)
      .generatedWorkspace(scaffolded)
  }

  """
  Generate a typed Java client for `target` in Workspace.cwd (the persisted
  scope). `target` is the engine-resolved module source, so no reference
  parsing happens here. Returns the workspace with the client written.
  """
  generateClient(
    ws: Workspace!,
    target: ModuleSource!,
    name: String = "",
  ): Workspace! {
    let rootPath = normalizePath(ws.cwd)
    # name is nullable (String, not String!); coerce before it feeds a String! param.
    let requested = name ?? ""
    let clientName = if (requested == "") { basename(rootPath) } else { requested }
    Client(
      rootPath: rootPath,
      module: target.moduleName,
      kindJSON: JSON.encode(target.kind),
      canonicalRef: target.asString,
      rootSubpath: target.sourceRootSubpath,
      pin: target.pin,
      engineVersion: target.engineVersion,
      schemaJSON: target.clientSchemaIntrospectionJSON.contents,
    ).generatedWorkspace(ws, clientPom(clientName))
  }

  """
  The requested template, falling back to default for an empty value.
  """
  let selectedTemplate: String! {
    if (template == "") { "default" } else { template }
  }

  """
  The dagger-module.toml a new Java module starts from: the module name, the
  engine version this SDK targets, a "." source, and this SDK's runtime.
  """
  let moduleConfig(name: String!): String! {
    "name = \"" + name + "\"\n" +
    "engineVersion = \"v1.0.0-beta.11\"\n" +
    "source = \".\"\n\n" +
    "[runtime]\n" +
    "  source = \"" + runtimeSource + "\"\n"
  }

  """
  Whether a workspace-root-relative path exists in the workspace.
  """
  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory("/", include: [path]).exists(path)
  }

  """
  Render a Java init template, substituting the requested module name.
  """
  let renderedTemplate(name: String!, template: String!): Directory! {
    renderedTemplateDir(name, "templates/" + template)
  }

  """
  The pom of a client named `name`, from the client template.
  """
  let clientPom(name: String!): File! {
    renderedTemplateDir(name, "client-template").file("pom.xml")
  }

  """
  Render a template directory of the module source, substituting the requested
  module name into every path and file it holds.
  """
  let renderedTemplateDir(name: String!, dir: String!): Directory! {
    container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory(
        "/helper",
        currentModule.source.directory("helpers/render-java-template"),
      )
      # target/ is gitignored, so it is absent from a clean checkout but present
      # in a developer's — and the renderer substitutes the module name into
      # every file it walks, including .class bytes, producing a corrupt class
      # that then breaks the scaffolded module's build.
      .withDirectory(
        "/template",
        currentModule.source.directory(dir),
        exclude: ["**/target/**"],
      )
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/render-java-template", "."])
      .withExec(["render-java-template", name, "/template", "/rendered"])
      .directory("/rendered")
  }

  """
  A workspace path in the form the engine agrees on: no leading "./" or "/", no
  trailing "/", "." for the root.
  """
  let normalizePath(path: String!): String! {
    let normalized = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (normalized == "") { "." } else { normalized }
  }

  """
  A module path as a workspace-root-absolute path ("/" for the root), the form
  Workspace resolves from the workspace root rather than from cwd.
  """
  let workspaceRef(path: String!): String! {
    if (path == ".") { "/" } else { "/" + path }
  }

  """
  Join a workspace path with a sub-path, handling the root (".") path.
  """
  let joinPath(path: String!, sub: String!): String! {
    if (path == ".") { sub } else { path + "/" + sub }
  }

  """
  The last segment of a path — a new module's name, taken from its directory.
  """
  let basename(path: String!): String! {
    normalizePath(path).split("/").reduce("module") { _, part => part }
  }

  """
  The normalized directory of a findUp match, dropping its marker filename.
  """
  let configDir(foundPath: String!, marker: String!): String! {
    normalizePath(foundPath.trimPrefix("/").trimSuffix(marker))
  }
}
